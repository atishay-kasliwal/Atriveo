{
  "manifest_version": 3,
  "name": "Atriveo Job Assistant",
  "version": "1.0.5",
  "description": "Detects ATS job pages and extracts structured job data.",
  "permissions": ["activeTab", "storage", "scripting", "tabs"],
  "host_permissions": [
    "https://*.myworkdayjobs.com/*",
    "https://*.greenhouse.io/*",
    "https://*.lever.co/*",
    "https://*.applytojob.com/*",
    "https://*.ashbyhq.com/*",
    "https://*.smartrecruiters.com/*",
    "https://*.icims.com/*",
    "https://*.jobvite.com/*",
    "https://*.bamboohr.com/*",
    "https://*.jazzhr.com/*",
    "https://*.taleo.net/*",
    "https://*.successfactors.com/*",
    "https://*.jobs.sap.com/*",
    "https://*.adp.com/*",
    "https://*.paylocity.com/*",
    "https://*.teamtailor.com/*",
    "https://*.recruitee.com/*",
    "https://*.workable.com/*",
    "https://*.jobscore.com/*",
    "https://*.clearcompany.com/*",
    "https://*.njoyn.com/*",
    "https://*.linkedin.com/*",
    "https://*.avature.net/*",
    "https://*.amazon.jobs/*",
    "https://*.ultipro.com/*",
    "https://*.jobright.ai/*",
    "https://job-tracker-api.katishay.workers.dev/*",
    "https://www.atriveo.com/*",
    "https://atriveo.com/*",
    "https://*.atriveo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Atriveo Job Assistant"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.myworkdayjobs.com/*",
        "https://*.greenhouse.io/*",
        "https://*.lever.co/*",
        "https://*.applytojob.com/*",
        "https://*.ashbyhq.com/*",
        "https://*.smartrecruiters.com/*",
        "https://*.icims.com/*",
        "https://*.jobvite.com/*",
        "https://*.bamboohr.com/*",
        "https://*.jazzhr.com/*",
        "https://*.taleo.net/*",
        "https://*.successfactors.com/*",
        "https://*.jobs.sap.com/*",
        "https://*.adp.com/*",
        "https://*.paylocity.com/*",
        "https://*.teamtailor.com/*",
        "https://*.recruitee.com/*",
        "https://*.workable.com/*",
        "https://*.jobscore.com/*",
        "https://*.clearcompany.com/*",
        "https://*.njoyn.com/*",
        "https://*.linkedin.com/*",
        "https://*.avature.net/*",
        "https://*.amazon.jobs/*",
        "https://*.ultipro.com/*",
        "https://*.jobright.ai/*"
      ],
      "exclude_matches": [
        "https://www.atriveo.com/*",
        "https://atriveo.com/*",
        "https://*.atriveo.com/*",
        "https://job-tracker-api.katishay.workers.dev/*"
      ],
      "js": [
        "utils/extractText.js",
        "content-scripts/detector.js",
        "content-scripts/floating-widget.js"
      ],
      "css": [
        "content-scripts/floating-widget.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
