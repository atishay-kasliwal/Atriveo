{
  "name": "job-tracker-dashboard",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "python3 scripts/run_migration.py",
    "db:import": "python3 scripts/import_xlsx.py",
    "users:seed": "npm run seed:users -w @job-tracker/api",
    "users:reset-passwords": "npm run seed:users:reset -w @job-tracker/api",
    "dev:web": "npm run dev -w @job-tracker/web",
    "dev:api": "npm run dev -w @job-tracker/api",
    "build:web": "npm run build -w @job-tracker/web",
    "build:api": "npm run build -w @job-tracker/api",
    "build:api:staging": "npm run build:staging -w @job-tracker/api",
    "deploy:api:staging": "npm run deploy:staging -w @job-tracker/api",
    "deploy:api:prod": "npm run deploy:prod -w @job-tracker/api",
    "audit:referrals": "npm run audit:referrals -w @job-tracker/api",
    "referrals:sync": "npm run referrals:sync -w @job-tracker/api"
  }
}
