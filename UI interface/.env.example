# Local (Docker) database URL (preferred for local development)
DATABASE_URL=postgresql://job_tracker:job_tracker@127.0.0.1:5432/job_tracker

# Optional: Neon database URL (used by the Cloudflare Worker runtime)
NEON_DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Optional: if set, API requires Authorization: Bearer <token> (otherwise it runs "open" and uses the owner user)
API_SHARED_TOKEN=

# Web app -> API URL (Node API or Wrangler dev)
VITE_API_URL=http://127.0.0.1:8787

# Optional: if API_SHARED_TOKEN is set, set the same token here
VITE_API_TOKEN=

# Optional: GA4 measurement ID for frontend tracking (example: G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# Optional: comma-separated hostnames allowed to send GA events
# Example: product.atishaykasliwal.com
VITE_GA_ALLOWED_HOSTS=
