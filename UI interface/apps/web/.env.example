# Copy to .env. Do not commit .env.
# Required: local Worker URL while running `npm run dev:api`.
VITE_API_URL=http://127.0.0.1:8787
# Optional: base path for router/build.
# Keep "/" so landing lives at `/` and app at `/dashboard`.
# Only change to "/dashboard/" if you deliberately host the SPA under a subpath.
VITE_APP_BASE=/
# Optional: only needed if you set API_SHARED_TOKEN on the API.
# Use the exact same value here. If the Worker has no token set, the API is open and this can be left empty.
VITE_API_TOKEN=
# Optional: GA4 measurement ID (example: G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=
# Optional: comma-separated hostnames where GA is allowed (example: product.atishaykasliwal.com)
VITE_GA_ALLOWED_HOSTS=
