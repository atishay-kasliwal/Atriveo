{
  "name": "@job-tracker/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev src/index.ts --local --show-interactive-dev-session=false",
    "build": "wrangler deploy --dry-run --env production",
    "build:staging": "wrangler deploy --dry-run --env staging",
    "deploy": "npm run deploy:prod",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:prod": "wrangler deploy --env production",
    "migrate": "node scripts/run-migrations.js",
    "audit:dashboard": "node scripts/audit-dashboard-api.mjs",
    "seed:users": "node scripts/seed-users.js",
    "seed:users:reset": "node scripts/seed-users.js --reset"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.1",
    "hono": "^4.7.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "typescript": "^5.7.3",
    "wrangler": "^4.67.0"
  }
}
