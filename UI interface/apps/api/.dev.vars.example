# Copy to `.dev.vars` (do not commit).
# Used by `wrangler dev` for local development.
NEON_DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# If set, the API accepts `Authorization: Bearer <token>` for all /api/* routes.
# If unset, you'll need to login via /auth/login (OWNER_* vars below).
API_SHARED_TOKEN=

# Optional owner email used only when API_SHARED_TOKEN is used.
OWNER_EMAIL=you@example.com

# Optional: disable public signups (default is enabled when unset).
SIGNUPS_ENABLED=true

# Optional: enable Google auth. Use the OAuth Web client ID(s) from Google Cloud.
# Set at least one of these.
GOOGLE_CLIENT_ID=
# Comma-separated allowlist (useful for multiple envs/domains).
GOOGLE_CLIENT_IDS=

# Optional: Resend email API key for forgot-password emails.
RESEND_API_KEY=

# Optional: sender address used for forgot-password emails.
EMAIL_FROM=noreply@atriveo.com

# Optional: reset link base used in emails.
# Examples:
# RESET_PASSWORD_URL_BASE=http://localhost:5173/?token=
# RESET_PASSWORD_URL_BASE=https://www.atriveo.com/?token=
RESET_PASSWORD_URL_BASE=

# Optional: reset token expiry in minutes (default 10, max 120).
PASSWORD_RESET_TOKEN_TTL_MINUTES=10

# Optional: media signed URL secret. If unset, API_SHARED_TOKEN is used as fallback.
MEDIA_URL_SIGNING_SECRET=

# Optional: if you expose your R2 bucket via custom/public domain, set base URL here.
# Example: https://media.atriveo.com
MEDIA_PUBLIC_BASE_URL=

# Optional: base URL used for company logos stored in R2.
# Example: https://cdn.atriveo.com
COMPANY_LOGO_BASE_URL=
